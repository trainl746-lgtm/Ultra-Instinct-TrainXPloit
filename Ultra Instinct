local function executeSmoothDodge(enemyRoot)
    if not scriptActive or not isEnabled then return end
    local now = os.clock()
    if now - lastTeleportTime < COOLDOWN then return end
    lastTeleportTime = now

    local myChar = localPlayer.Character
    if not myChar then return end
    local myRoot = myChar:FindFirstChild("HumanoidRootPart")
    local myHumanoid = myChar:FindFirstChildOfClass("Humanoid")
    if not myRoot or not myHumanoid then return end

    local wasSpecialInterrupted = false
    if currentSpecialCleanup then
        currentSpecialCleanup()
        currentSpecialCleanup = nil
        wasSpecialInterrupted = true
    end

    local isSpecialProc = not wasSpecialInterrupted and (math.random(1, 20) == 1)

    if isSpecialProc then
        local enemyHead = enemyRoot.Parent and enemyRoot.Parent:FindFirstChild("Head") or enemyRoot
        local targetCFrame = CFrame.new(enemyHead.Position + Vector3.new(0, 3.5, 0)) * CFrame.Angles(0, math.rad(enemyRoot.Orientation.Y), 0)
        
        myRoot.CFrame = targetCFrame

        local originalWalkSpeed = myHumanoid.WalkSpeed
        local originalJumpPower = myHumanoid.JumpPower
        myHumanoid.WalkSpeed = 0
        myHumanoid.JumpPower = 0

        local anim = Instance.new("Animation")
        anim.AnimationId = "rbxassetid://84458677375099"
        local animator = myHumanoid:FindFirstChildOfClass("Animator") or myHumanoid:WaitForChild("Animator", 1)
        
        if animator then
            local track = animator:LoadAnimation(anim)
            track:Play()
            
            local fallConn
            local isCleanedUp = false

            local function cleanup()
                if isCleanedUp then return end
                isCleanedUp = true
                if currentSpecialCleanup == cleanup then currentSpecialCleanup = nil end
                if fallConn then fallConn:Disconnect() fallConn = nil end
                if lockOnConnection then lockOnConnection:Disconnect() lockOnConnection = nil end

                local camera = Workspace.CurrentCamera
                if camera then
                    camera.CameraType = Enum.CameraType.Custom
                    if myHumanoid then
                        camera.CameraSubject = myHumanoid
                        myHumanoid.WalkSpeed = originalWalkSpeed
                        myHumanoid.JumpPower = originalJumpPower
                    end
                end

                if track and track.IsPlaying then track:Stop() end
                if track then track:Destroy() end
            end

            currentSpecialCleanup = cleanup

            task.delay(0.15, function()
                if not scriptActive or isCleanedUp then return end
                if myHumanoid:GetState() == Enum.HumanoidStateType.Freefall or myHumanoid:GetState() == Enum.HumanoidStateType.FallingDown then
                    cleanup()
                    return
                end

                fallConn = myHumanoid.StateChanged:Connect(function(_, newState)
                    if newState == Enum.HumanoidStateType.Freefall or newState == Enum.HumanoidStateType.FallingDown then
                        cleanup()
                    end
                end)
            end)

            task.delay(2.5, function() cleanup() end)
        end

        if autoM1Enabled then
            m1LockedOutUntil = os.clock() + 0.5
            pcall(function()
                local tool = myChar:FindFirstChildOfClass("Tool")
                if tool then
                    tool:Activate()
                else
                    VirtualInputManager:SendMouseButtonEvent(0, 0, 0, true, game, 0)
                    task.wait(0.05)
                    VirtualInputManager:SendMouseButtonEvent(0, 0, 0, false, game, 0)
                end
            end)
        elseif autoBlockEnabled then
            task.delay(currentBlockDelay, function()
                if not scriptActive or not isEnabled then return end
                pcall(function()
                    VirtualInputManager:SendKeyEvent(true, Enum.KeyCode.F, false, game)
                    task.delay(0.1, function() pcall(function() VirtualInputManager:SendKeyEvent(false, Enum.KeyCode.F, false, game) end) end)
                end)
            end)
        end

        local camera = Workspace.CurrentCamera
        if lockOnConnection then lockOnConnection:Disconnect() end
        
        camera.CameraType = Enum.CameraType.Scriptable
        local startTime = os.clock()
        local duration = 2.5

        lockOnConnection = RunService.RenderStepped:Connect(function()
            if not scriptActive then
                if lockOnConnection then lockOnConnection:Disconnect() lockOnConnection = nil end
                return
            end
            local elapsed = os.clock() - startTime
            
            if elapsed >= duration or not enemyRoot or not enemyRoot.Parent or not myRoot or not myRoot.Parent then
                if lockOnConnection then lockOnConnection:Disconnect() lockOnConnection = nil end
                camera.CameraType = Enum.CameraType.Custom
                if myHumanoid then camera.CameraSubject = myHumanoid end
                return
            end

            local myPos = myRoot.Position
            local enemyPos = enemyRoot.Position
            local camPos = myPos + Vector3.new(0, 4, 8)
            camera.CFrame = CFrame.lookAt(camPos, enemyPos)
        end)
    else
        local randomAngle = math.rad(math.random(120, 240))
        local randomDist = math.random(40, 60) / 10
        local relativeOffset = Vector3.new(math.sin(randomAngle) * randomDist, 0, -math.cos(randomAngle) * randomDist)
        
        local targetWorldPos = (enemyRoot.CFrame * CFrame.new(relativeOffset)).Position
        local targetCFrame = CFrame.lookAt(
            Vector3.new(targetWorldPos.X, myRoot.Position.Y, targetWorldPos.Z), 
            Vector3.new(enemyRoot.Position.X, myRoot.Position.Y, enemyRoot.Position.Z)
        )

        local dodgeId = getRandomDodge()
        local anim = Instance.new("Animation")
        anim.AnimationId = "rbxassetid://" .. dodgeId
        local animator = myHumanoid:FindFirstChildOfClass("Animator") or myHumanoid:WaitForChild("Animator", 1)
        
        if animator then
            local track = animator:LoadAnimation(anim)
            track:Play()
            task.delay(0.6, function()
                if track and track.IsPlaying then track:Stop() end
                if track then track:Destroy() end
            end)
        end

        if autoM1Enabled then
            m1LockedOutUntil = os.clock() + 0.5
            pcall(function()
                local tool = myChar:FindFirstChildOfClass("Tool")
                if tool then
                    tool:Activate()
                else
                    VirtualInputManager:SendMouseButtonEvent(0, 0, 0, true, game, 0)
                    task.wait(0.05)
                    VirtualInputManager:SendMouseButtonEvent(0, 0, 0, false, game, 0)
                end
            end)
        elseif autoBlockEnabled then
            task.delay(currentBlockDelay, function()
                if not scriptActive or not isEnabled then return end
                pcall(function()
                    VirtualInputManager:SendKeyEvent(true, Enum.KeyCode.F, false, game)
                    task.delay(0.1, function() pcall(function() VirtualInputManager:SendKeyEvent(false, Enum.KeyCode.F, false, game) end) end)
                end)
            end)
        end

        local tweenInfo = TweenInfo.new(0.18, Enum.EasingStyle.Cubic, Enum.EasingDirection.Out)
        local tween = TweenService:Create(myRoot, tweenInfo, {CFrame = targetCFrame})
        tween:Play()

        local camera = Workspace.CurrentCamera
        if lockOnConnection then lockOnConnection:Disconnect() end
        
        camera.CameraType = Enum.CameraType.Scriptable
        local startTime = os.clock()
        local duration = 0.6

        lockOnConnection = RunService.RenderStepped:Connect(function()
            if not scriptActive then
                if lockOnConnection then lockOnConnection:Disconnect() lockOnConnection = nil end
                return
            end
            local elapsed = os.clock() - startTime
            
            if elapsed >= duration or not enemyRoot or not enemyRoot.Parent or not myRoot or not myRoot.Parent then
                if lockOnConnection then lockOnConnection:Disconnect() lockOnConnection = nil end
                camera.CameraType = Enum.CameraType.Custom
                if myHumanoid then camera.CameraSubject = myHumanoid end
                return
            end

            local myPos = myRoot.Position
            local enemyPos = enemyRoot.Position
            local offsetDir = (myPos - enemyPos).Unit
            if offsetDir.Magnitude == 0 then offsetDir = Vector3.new(0, 0, 1) end
            
