-- Helpers & UI Framework
--------------------------------------------------------------------
local connections = {}
local function connect(signal, fn)
    local c = signal:Connect(fn)
    table.insert(connections, c)
    return c
end

local function create(class, props, children)
    local inst = Instance.new(class)
    local parent
    for k, v in pairs(props or {}) do
        if k == "Parent" then
            parent = v
        else
            inst[k] = v
        end
    end
    for _, child in ipairs(children or {}) do
        child.Parent = inst
    end
    inst.Parent = parent
    return inst
end

local function corner(radius)
    return create("UICorner", { CornerRadius = UDim.new(0, radius) })
end

local function stroke(color)
    return create("UIStroke", {
        Color = color,
        Thickness = 1,
        ApplyStrokeMode = Enum.ApplyStrokeMode.Border,
    })
end

local TWEEN_INFO = TweenInfo.new(0.12, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
local function tween(inst, props, instant)
    if instant then
        for k, v in pairs(props) do
            inst[k] = v
        end
    else
        TweenService:Create(inst, TWEEN_INFO, props):Play()
    end
end

local Changed = Instance.new("BindableEvent")
local updateHandlers = {}

local function setConfig(key, value)
    Config[key] = value
    Changed:Fire(key, value)
    saveConfig()
end

Changed.Event:Connect(function(key, value)
    if key == "Enabled" then isEnabled = value
    elseif key == "AutoCounter" then
        autoM1Enabled = value
        if value then
            autoBlockEnabled = false
            Config.AutoBlock = false
            if updateHandlers["AutoBlock"] then updateHandlers["AutoBlock"](false) end
        end
    elseif key == "AutoBlock" then
        autoBlockEnabled = value
        if value then
            autoM1Enabled = false
            Config.AutoCounter = false
            if updateHandlers["AutoCounter"] then updateHandlers["AutoCounter"](false) end
        end
    elseif key == "AutoProj" then autoProjEnabled = value
    elseif key == "DashRange" then currentDashRange = value
    elseif key == "M1Range" then currentM1Range = value
    elseif key == "MoveRange" then currentMoveRange = value
    elseif key == "ProjRange" then currentProjRange = value
    elseif key == "ProjMinRange" then currentProjMinRange = value
    elseif key == "MinRange" then currentMinRange = value
    elseif key == "MoveDelay" then currentMoveDelay = value
    elseif key == "BlockDelay" then currentBlockDelay = value
    end

    if updateHandlers[key] then
        updateHandlers[key](value)
    end
end)

