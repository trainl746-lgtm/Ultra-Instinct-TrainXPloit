local function iconButton(xOffset)
    local btn = create("TextButton", {
        AnchorPoint = Vector2.new(1, 0.5),
        Position = UDim2.new(1, xOffset, 0.5, 0),
        Size = UDim2.fromOffset(26, 26),
        BackgroundColor3 = Theme.Hover,
        BackgroundTransparency = 1,
        AutoButtonColor = false,
        Text = "",
        Parent = header,
    }, { corner(Theme.Radius) })

    local bars = {}
    local function addBar(w, h, rotation)
        local b = create("Frame", {
            AnchorPoint = Vector2.new(0.5, 0.5),
            Position = UDim2.fromScale(0.5, 0.5),
            Size = UDim2.fromOffset(w, h),
            Rotation = rotation or 0,
            BackgroundColor3 = Theme.Dim,
            BorderSizePixel = 0,
            Parent = btn,
        })
        table.insert(bars, b)
        return b
    end

    btn.MouseEnter:Connect(function()
        tween(btn, { BackgroundTransparency = 0 })
        for _, b in ipairs(bars) do
            tween(b, { BackgroundColor3 = Theme.Text })
        end
    end)
    btn.MouseLeave:Connect(function()
        tween(btn, { BackgroundTransparency = 1 })
        for _, b in ipairs(bars) do
            tween(b, { BackgroundColor3 = Theme.Dim })
        end
    end)

    return btn, addBar
end

