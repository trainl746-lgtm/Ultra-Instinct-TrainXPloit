local function monitorHumanoid(humanoid, character)
    if character == localPlayer.Character then return end
    
    connect(humanoid.AnimationPlayed, function(track)
        if not scriptActive or not isEnabled then return end
        
        pcall(function()
            if track and track.Animation and track.Animation.AnimationId then
                local id = track.Animation.AnimationId:match("%d+")
                if id then
                    local requiredRange = nil
                    local isSpecialMove = false
                    
                    if chaseDashIds[id] then
                        requiredRange = currentDashRange
                    elseif m1Ids[id] then
                        requiredRange = currentM1Range
                    elseif parsedMoveIds[id] then
                        requiredRange = currentMoveRange
                        isSpecialMove = true
                    end
                    
                    if requiredRange then
                        local myChar = localPlayer.Character
                        if not myChar then return end
                        local myRoot = myChar:FindFirstChild("HumanoidRootPart")
                        local enemyRoot = character:FindFirstChild("HumanoidRootPart")
                        
                        if myRoot and enemyRoot then
                            local dist = (enemyRoot.Position - myRoot.Position).Magnitude
                            if dist <= requiredRange and dist >= currentMinRange then
                                if isSpecialMove then
                                    task.delay(currentMoveDelay, function()
                                        if not scriptActive or not isEnabled then return end
                                        local curChar = localPlayer.Character
                                        if not curChar then return end
                                        local curRoot = curChar:FindFirstChild("HumanoidRootPart")
                                        if curRoot and enemyRoot and enemyRoot.Parent then
                                            local d = (enemyRoot.Position - curRoot.Position).Magnitude
                                            if d <= currentMoveRange and d >= currentMinRange then
                                                executeSmoothDodge(enemyRoot)
                                            end
                                        end
                                    end)

                                    task.spawn(function()
                                        local startTime = os.clock()
                                        local stopped = false
                                        local conn
                                        
                                        local stopConn = track.Stopped:Connect(function()
                                            stopped = true
                                            if conn then conn:Disconnect() end
                                        end)
                                        
                                        conn = RunService.Heartbeat:Connect(function()
                                            if not scriptActive or stopped or not track.IsPlaying or not character.Parent then
                                                if conn then conn:Disconnect() end
                                                if stopConn then stopConn:Disconnect() end
                                                return
                                            end
                                            
                                            if os.clock() - startTime >= 1 then
                                                stopped = true
                                                if conn then conn:Disconnect() end
                                                if stopConn then stopConn:Disconnect() end
                                                
                                                if not scriptActive or not isEnabled then return end
                                                local curChar = localPlayer.Character
                                                if not curChar then return end
                                                local curRoot = curChar:FindFirstChild("HumanoidRootPart")
                                                local enemyRoot = character:FindFirstChild("HumanoidRootPart")
                                                if curRoot and enemyRoot and enemyRoot.Parent then
                                                    local d = (enemyRoot.Position - curRoot.Position).Magnitude
                                                    if d <= currentMoveRange and d >= currentMinRange then
                                                        executeSmoothDodge(enemyRoot)
                                                    end
                                                end
                                            end
                                        end)
                                    end)
                                else
                                    executeSmoothDodge(enemyRoot)
                                end
                            end
                        end
                    end
                end
            end
        end)
    end)
end

