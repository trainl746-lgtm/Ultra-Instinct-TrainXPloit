local trackedProjectiles = {}

connect(Workspace.DescendantAdded, function(descendant)
    if not scriptActive then return end
    if descendant:IsA("BasePart") and not descendant.Anchored then
        if descendant.Parent and descendant.Parent:FindFirstChildOfClass("Humanoid") then return end
        trackedProjectiles[descendant] = os.clock()
    end
end)

connect(Workspace.DescendantRemoving, function(descendant)
    if not scriptActive then return end
    trackedProjectiles[descendant] = nil
end)

connect(RunService.Heartbeat, function()
    if not scriptActive or not isEnabled or not autoProjEnabled then return end
    
    local now = os.clock()
    local myChar = localPlayer.Character
    local myRoot = myChar and myChar:FindFirstChild("HumanoidRootPart")
    if not myRoot then return end

    for part, addTime in pairs(trackedProjectiles) do
        if not part or not part.Parent then
            trackedProjectiles[part] = nil
            continue
        end

        if now - addTime > 3 then
            trackedProjectiles[part] = nil
            continue
        end
        
        local success, vel = pcall(function() return part.AssemblyLinearVelocity end)
        if success and vel and vel.Magnitude > 35 then
            local dist = (part.Position - myRoot.Position).Magnitude
            if dist <= currentProjRange and dist >= currentProjMinRange then
                local dirToMe = (myRoot.Position - part.Position).Unit
                local velDir = vel.Unit
                local dotProduct = dirToMe:Dot(velDir)
                
                if dotProduct > 0.92 then
                    executeProjectileDodge(part, velDir)
                    trackedProjectiles[part] = nil
                end
            end
        end
    end
end)

