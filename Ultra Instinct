local function getRandomDodge()
    local available = {}
    for _, id in ipairs(dodgeIds) do
        if id ~= lastDodgeId then
            table.insert(available, id)
        end
    end
    if #available == 0 then available = dodgeIds end
    local chosen = available[math.random(1, #available)]
    lastDodgeId = chosen
    return chosen
end

-- PROJECTILE DODGE LOGIC
local function executeProjectileDodge(projectilePart, incomingDir)
    if not scriptActive or not isEnabled then return end
    local now = os.clock()
    if now - lastProjTime < PROJ_COOLDOWN then return end
    lastProjTime = now

    local myChar = localPlayer.Character
    if not myChar then return end
    local myRoot = myChar:FindFirstChild("HumanoidRootPart")
    local myHumanoid = myChar:FindFirstChildOfClass("Humanoid")
    if not myRoot or not myHumanoid then return end

    local upVector = Vector3.new(0, 1, 0)
    local rightVector = incomingDir:Cross(upVector).Unit
    
    if rightVector.Magnitude == 0 or rightVector.Magnitude ~= rightVector.Magnitude then
        rightVector = Vector3.new(1, 0, 0)
    end
    
    local dodgeDir = (math.random() > 0.5) and rightVector or -rightVector
    local dodgeDist = 18 
    
    local targetWorldPos = myRoot.Position + (dodgeDir * dodgeDist)
    local targetCFrame = CFrame.lookAt(
        Vector3.new(targetWorldPos.X, myRoot.Position.Y, targetWorldPos.Z), 
        Vector3.new(myRoot.Position.X - (incomingDir.X * 10), myRoot.Position.Y, myRoot.Position.Z - (incomingDir.Z * 10))
    )

    local dodgeId = getRandomDodge()
    local anim = Instance.new("Animation")
    anim.AnimationId = "rbxassetid://" .. dodgeId
    local animator = myHumanoid:FindFirstChildOfClass("Animator") or myHumanoid:WaitForChild("Animator", 1)
    
    if animator then
        local track = animator:LoadAnimation(anim)
        track:Play()
        task.delay(0.6, function()
            if track and track.IsPlaying then track:Stop() end
            if track then track:Destroy() end
        end)
    end

    if autoM1Enabled then
        m1LockedOutUntil = os.clock() + 0.5
        pcall(function()
            local tool = myChar:FindFirstChildOfClass("Tool")
            if tool then
                tool:Activate()
            else
                VirtualInputManager:SendMouseButtonEvent(0, 0, 0, true, game, 0)
                task.wait(0.05)
                VirtualInputManager:SendMouseButtonEvent(0, 0, 0, false, game, 0)
            end
        end)
    elseif autoBlockEnabled then
        task.delay(currentBlockDelay, function()
            if not scriptActive or not isEnabled then return end
            pcall(function()
                VirtualInputManager:SendKeyEvent(true, Enum.KeyCode.F, false, game)
                task.delay(0.1, function()
                    pcall(function() VirtualInputManager:SendKeyEvent(false, Enum.KeyCode.F, false, game) end)
                end)
            end)
        end)
    end

    local tweenInfo = TweenInfo.new(0.18, Enum.EasingStyle.Cubic, Enum.EasingDirection.Out)
    local tween = TweenService:Create(myRoot, tweenInfo, {CFrame = targetCFrame})
    tween:Play()
end

