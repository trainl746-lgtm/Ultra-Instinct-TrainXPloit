        if child:IsA("Humanoid") then
            monitorHumanoid(child, model)
        end
    end)
end

for _, p in ipairs(Players:GetPlayers()) do
    connect(p.CharacterAdded, function(char)
        if not scriptActive then return end
        local humanoid = char:WaitForChild("Humanoid", 5)
        if humanoid then monitorHumanoid(humanoid, char) end
    end)
    if p.Character then
        local humanoid = p.Character:FindFirstChildOfClass("Humanoid")
        if humanoid then monitorHumanoid(humanoid, p.Character) end
    end
end

connect(Players.PlayerAdded, function(player)
    connect(player.CharacterAdded, function(char)
        if not scriptActive then return end
