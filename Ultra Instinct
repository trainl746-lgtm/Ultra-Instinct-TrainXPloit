local saveFileName = "UltraInstinctConfig.json"

local function saveConfig()
    pcall(function()
        if writefile then
            writefile(saveFileName, HttpService:JSONEncode(Config))
        end
    end)
end

local function loadConfig()
    pcall(function()
        if isfile and readfile and isfile(saveFileName) then
            local decoded = HttpService:JSONDecode(readfile(saveFileName))
            if type(decoded) == "table" then
                for k, v in pairs(decoded) do
                    if Config[k] ~= nil and type(Config[k]) == type(v) then
                        Config[k] = v
                    end
                end
            end
        end
    end)
end

