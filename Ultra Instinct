local function createToggle(text, key)
    local row = create("TextButton", {
        Size = UDim2.new(1, 0, 0, 26),
        BackgroundColor3 = Theme.Hover,
        BackgroundTransparency = 1,
        AutoButtonColor = false,
        Text = "",
        LayoutOrder = nextOrder(),
        Parent = body,
    }, { corner(Theme.Radius) })

    local boxStroke = stroke(Theme.LineStrong)
    local box = create("Frame", {
        AnchorPoint = Vector2.new(0, 0.5),
        Position = UDim2.new(0, 8, 0.5, 0),
        Size = UDim2.fromOffset(12, 12),
        BackgroundTransparency = 1,
        Parent = row,
    }, { corner(Theme.Radius), boxStroke })

    local fill = create("Frame", {
        AnchorPoint = Vector2.new(0.5, 0.5),
        Position = UDim2.fromScale(0.5, 0.5),
        Size = UDim2.fromOffset(0, 0),
        BackgroundColor3 = Theme.Accent,
        BorderSizePixel = 0,
        Parent = box,
    })

    local label = create("TextLabel", {
        Position = UDim2.fromOffset(30, 0),
        Size = UDim2.new(1, -30, 1, 0),
        BackgroundTransparency = 1,
        Text = text,
        Font = Theme.LabelFont,
        TextSize = 16,
        TextColor3 = Theme.Dim,
        TextXAlignment = Enum.TextXAlignment.Left,
        Parent = row,
    })

    local function render(instant)
        local on = Config[key]
        tween(fill, { Size = on and UDim2.fromOffset(6, 6) or UDim2.fromOffset(0, 0) }, instant)
        tween(boxStroke, { Color = on and Theme.Accent or Theme.LineStrong }, instant)
        tween(label, { TextColor3 = on and Theme.Text or Theme.Dim }, instant)
    end
    render(true)

    updateHandlers[key] = function()
        render()
    end

    row.MouseEnter:Connect(function()
        tween(row, { BackgroundTransparency = 0 })
    end)
    row.MouseLeave:Connect(function()
        tween(row, { BackgroundTransparency = 1 })
    end)
    row.Activated:Connect(function()
        if key == "AutoCounter" and not Config.AutoCounter then
            setConfig("AutoCounter", true)
            setConfig("AutoBlock", false)
        elseif key == "AutoBlock" and not Config.AutoBlock then
            setConfig("AutoBlock", true)
            setConfig("AutoCounter", false)
        else
            setConfig(key, not Config[key])
        end
        render()
    end)
end

